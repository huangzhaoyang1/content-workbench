# ============================================================
# 环境变量示例。复制成 .env 用于本地，或照抄到 Render / Vercel 控制台。
# 真实的 .env 已被 .gitignore 忽略，不会提交到 GitHub。
# ============================================================

# ---------- 后端（Render）----------
# DeepSeek（写稿 / 智能分析）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选，默认 https://api.deepseek.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 可选，默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# SerpAPI（真实热点搜索），不填会自动退回内置 mock 数据
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# 微信公众号（推草稿箱用，云端暂时用不到，先留着）
WX_APPID=wx0000000000000000
WX_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 前端域名，用于 CORS 白名单。多个域名用英文逗号分隔，不要带结尾斜杠
FRONTEND_URL=https://content-workbench.vercel.app

# 每日搜索次数上限（防止 SerpAPI 超额扣费）
DAILY_LIMIT=50

# 是否放行 Vercel 预览域名（*.vercel.app），默认 1 开启，设 0 关闭
ALLOW_VERCEL_PREVIEWS=1

# 本地流水线项目根目录（云端不用填，填了也没有这个目录）
# STREAMLIT_PROJECT_ROOT=C:\Users\你的用户名\WorkBuddy\简约风格

# ---------- 前端（Vercel）----------
# 后端地址，不要带结尾斜杠
NEXT_PUBLIC_API_URL=https://content-workbench-backend.onrender.com
