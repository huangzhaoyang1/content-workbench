# ===================== 环境变量 / 密钥（最重要，别动）=====================
.env
.env.*
!.env.example
*.pem
*.key

# ===================== 数据目录（含真实 API Key，绝不提交）=====================
# 只忽略目录内容、保留目录本身，这样 .gitkeep 的反选规则才会生效
data/*
backend/data/*
!backend/data/.gitkeep

